---
// Self-contained contact page — no external layout import required
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact — Nikhil Nagaraj</title>
  </head>
  <body>
    <nav class="top-nav">
      <a href="/">← home</a>
    </nav>

    <main class="contact-container">
      <header class="contact-header">
        <h1>// contact</h1>
        <p class="subtitle">sound design, direction, & collaborations</p>
      </header>

      <div class="contact-grid">
        <div class="contact-info">
          <p>Available for select film, interactive, and spatial audio commissions.</p>
          <div class="direct-links">
            <p class="label">// direct</p>
            <a href="mailto:contact@nnik.in">contact@nnik.in</a>
          </div>
        </div>

        <form action="https://formspree.io/f/mjywyjgo" method="POST" class="contact-form">
          <div class="form-group">
            <label for="name">// name</label>
            <input type="text" id="name" name="name" required placeholder="your name" />
          </div>

          <div class="form-group">
            <label for="email">// email</label>
            <input type="email" id="email" name="email" required placeholder="your@email.com" />
          </div>

          <div class="form-group">
            <label for="subject">// subject</label>
            <input type="text" id="subject" name="subject" required placeholder="project inquiry / collaboration" />
          </div>

          <div class="form-group">
            <label for="message">// message</label>
            <textarea id="message" name="message" rows="6" required placeholder="details about your inquiry..."></textarea>
          </div>

          <button type="submit" class="submit-btn">[send message]</button>
        </form>
      </div>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: dark light;
  }

  body {
    margin: 0;
    background: #0a0a0a;
    color: #ededed;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    -webkit-font-smoothing: antialiased;
  }

  @media (prefers-color-scheme: light) {
    body {
      background: #fafafa;
      color: #111111;
    }
  }

  .top-nav {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem 0;
  }

  .top-nav a {
    color: inherit;
    text-decoration: none;
    font-size: 0.85rem;
    opacity: 0.6;
  }

  .top-nav a:hover {
    opacity: 1;
  }

  .contact-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  .contact-header {
    margin-bottom: 3.5rem;
  }

  h1 {
    font-size: 1.5rem;
    font-weight: 400;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
  }

  .subtitle {
    opacity: 0.6;
    font-size: 0.9rem;
    margin: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-info p {
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.85;
    margin-top: 0;
  }

  .direct-links {
    margin-top: 2rem;
  }

  .direct-links .label {
    font-size: 0.8rem;
    opacity: 0.5;
    margin-bottom: 0.25rem;
  }

  .direct-links a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    font-size: 0.95rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  label {
    font-size: 0.8rem;
    opacity: 0.7;
  }

  input,
  textarea {
    background: transparent;
    border: 1px solid rgba(128, 128, 128, 0.35);
    padding: 0.75rem 1rem;
    color: inherit;
    font-family: inherit;
    font-size: 0.95rem;
    border-radius: 0;
    transition: border-color 0.2s ease;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: currentColor;
  }

  .submit-btn {
    align-self: flex-start;
    background: transparent;
    border: 1px solid currentColor;
    color: inherit;
    font-family: inherit;
    font-size: 0.9rem;
    padding: 0.75rem 1.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .submit-btn:hover {
    background: currentColor;
    color: #0a0a0a;
  }

  @media (prefers-color-scheme: light) {
    .submit-btn:hover {
      color: #fafafa;
    }
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
