---
// Self-contained contact page — enlarged layout & typography
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact — Nikhil Nagaraj</title>
  </head>
  <body>
    <nav class="top-nav">
      <a href="/">← home</a>
    </nav>

    <main class="contact-container">
      <header class="contact-header">
        <h1>// contact</h1>
        <p class="subtitle">sound design, direction, & collaborations</p>
      </header>

      <div class="contact-grid">
        <div class="contact-info">
          <p>Available for select film, interactive, and spatial audio commissions.</p>
        </div>

        <form action="https://formspree.io/f/mjywyjgo" method="POST" class="contact-form">
          <div class="form-group">
            <label for="name">// name</label>
            <input type="text" id="name" name="name" required placeholder="your name" />
          </div>

          <div class="form-group">
            <label for="email">// email</label>
            <input type="email" id="email" name="email" required placeholder="your@email.com" />
          </div>

          <div class="form-group">
            <label for="subject">// subject</label>
            <input type="text" id="subject" name="subject" required placeholder="project inquiry / collaboration" />
          </div>

          <div class="form-group">
            <label for="message">// message</label>
            <textarea id="message" name="message" rows="7" required placeholder="details about your inquiry..."></textarea>
          </div>

          <button type="submit" class="submit-btn">[send message]</button>
        </form>
      </div>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: dark light;
  }

  body {
    margin: 0;
    background: #0a0a0a;
    color: #ededed;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    -webkit-font-smoothing: antialiased;
  }

  @media (prefers-color-scheme: light) {
    body {
      background: #fafafa;
      color: #111111;
    }
  }

  .top-nav {
    max-width: 1080px;
    margin: 0 auto;
    padding: 2.5rem 2rem 0;
  }

  .top-nav a {
    color: inherit;
    text-decoration: none;
    font-size: 1rem;
    opacity: 0.6;
  }

  .top-nav a:hover {
    opacity: 1;
  }

  .contact-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 3.5rem 2rem 5rem;
  }

  .contact-header {
    margin-bottom: 4rem;
  }

  h1 {
    font-size: 2.1rem;
    font-weight: 400;
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.02em;
  }

  .subtitle {
    opacity: 0.65;
    font-size: 1.1rem;
    margin: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 4.5rem;
    align-items: start;
  }

  .contact-info p {
    font-size: 1.15rem;
    line-height: 1.7;
    opacity: 0.85;
    margin-top: 0;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  label {
    font-size: 0.95rem;
    opacity: 0.75;
  }

  input,
  textarea {
    background: transparent;
    border: 1px solid rgba(128, 128, 128, 0.4);
    padding: 1rem 1.2rem;
    color: inherit;
    font-family: inherit;
    font-size: 1.1rem;
    border-radius: 0;
    transition: border-color 0.2s ease;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: currentColor;
  }

  .submit-btn {
    align-self: flex-start;
    background: transparent;
    border: 1px solid currentColor;
    color: inherit;
    font-family: inherit;
    font-size: 1.05rem;
    padding: 1rem 2rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .submit-btn:hover {
    background: currentColor;
    color: #0a0a0a;
  }

  @media (prefers-color-scheme: light) {
    .submit-btn:hover {
      color: #fafafa;
    }
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
